<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SQLite is called through LibraryImport, whose generated stubs are unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Storage tests read and fault the session file through the core's own
         connection, and history tests walk visits against a small history limit. -->
    <InternalsVisibleTo Include="CrestCore.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Public Suffix List (MPL 2.0), read by Domain/Sites/PublicSuffixList.cs. -->
    <EmbeddedResource Include="Domain/Sites/public_suffix_list.dat" LogicalName="CrestCore.Domain.Sites.public_suffix_list.dat" />
  </ItemGroup>
</Project>
